[Unit]
Description=RC Operations Hub Backend
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=poprc
Group=poprc
WorkingDirectory=/opt/poprc/current/backend
EnvironmentFile=/etc/poprc/poprc.env
ExecStart=/usr/bin/java -XX:MaxRAMPercentage=75.0 -jar /opt/poprc/current/backend/poprc.jar
SuccessExitStatus=143
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0027

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/poprc/uploads

[Install]
WantedBy=multi-user.target
