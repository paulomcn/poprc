# Copie para /etc/poprc/poprc.env e mantenha permissao 0640 root:poprc.
# Use apenas valores sem espacos. Para senhas, prefira: openssl rand -hex 32

APP_SECURITY_ENABLED=true
DEV_LOGIN_ENABLED=false
ZOHO_ENABLED=false
REAUTHENTICATION_MINUTES=5
SESSION_TIMEOUT=8h
SESSION_COOKIE_SECURE=true
FORWARD_HEADERS_STRATEGY=framework

SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8085
FRONTEND_URL=https://app.exemplo.com.br
APP_CORS_ALLOWED_ORIGIN_PATTERNS=https://app.exemplo.com.br

DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=poprc
DB_URL=jdbc:postgresql://127.0.0.1:5432/poprc
DB_USERNAME=poprc
DB_PASSWORD=SUBSTITUA_POR_UMA_SENHA_HEXADECIMAL_FORTE

APP_UPLOAD_DIR=/var/lib/poprc/uploads
JPA_SHOW_SQL=false

ALERT_EMAIL_ENABLED=false
MAIL_HOST=localhost
MAIL_PORT=25
MAIL_USERNAME=nao-configurado
MAIL_PASSWORD=nao-configurado
MAIL_SMTP_AUTH=false
MAIL_STARTTLS_ENABLED=false

BACKUP_DIR=/var/backups/poprc
BACKUP_RETENTION_DAYS=14
