# Deixe VITE_API_ORIGIN vazio para usar o proxy /api do Vite.
VITE_API_ORIGIN=
VITE_PROXY_TARGET=http://localhost:8085

# O build usa package.json e o commit Git automaticamente. Estes campos sao
# opcionais para pipelines que compilam fora de um clone do repositorio.
VITE_APP_VERSION=
VITE_APP_REVISION=

# Informe apenas hosts externos realmente usados, separados por virgula.
# Enderecos IP locais continuam aceitos pelo Vite sem configuracao adicional.
VITE_ALLOWED_HOSTS=
